# Server options
PORT=3007
NODE_ENV=development
COOKIE_SECRET=my-secret

# Health check
HEALTH_CHECK_ENABLED=false

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# Registration
REGISTRATION_EMAIL_CONFIRMATION_ENABLED=false
# otp | magic_link (used only when confirmation is enabled)
REGISTRATION_EMAIL_CONFIRMATION_METHOD=otp
# HMAC-SHA256 key for confirmation codes and link tokens, at least 32 bytes
LOGIN_CHALLENGE_HMAC_KEY=change-me-to-a-random-string-of-at-least-32-bytes

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true
