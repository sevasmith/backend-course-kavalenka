# Server options
PORT=3007
NODE_ENV=development
COOKIE_SECRET=my-secret

# Health check (readiness: fails while the RBAC policy is unavailable)
HEALTH_CHECK_ENABLED=true

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10
# Per IP, separately for register and resend: LIMIT requests per TTL ms
THROTTLE_REGISTRATION_TTL=60000
THROTTLE_REGISTRATION_LIMIT=5
# Per IP for POST /auth/login: task.md sets 30 requests per minute
THROTTLE_LOGIN_TTL=60000
THROTTLE_LOGIN_LIMIT=30

# Registration
REGISTRATION_EMAIL_CONFIRMATION_ENABLED=false
# otp | magic_link (used only when confirmation is enabled)
REGISTRATION_EMAIL_CONFIRMATION_METHOD=otp
# HMAC-SHA256 key for registration codes and link tokens: a random key of at
# least 32 bytes, different from the auth keys below (openssl rand -base64 32)
REGISTRATION_CHALLENGE_HMAC_KEY=
# Page the magic link opens; the token is appended after # (required for magic_link)
REGISTRATION_CONFIRM_URL=http://localhost:3000/register/confirm

# Authentication
# Four different random keys, each at least 32 bytes and different from the
# registration key above. Generate each one with:
#   openssl rand -base64 32
# Never reuse a key for two purposes or commit a real one.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
LOGIN_CHALLENGE_HMAC_KEY=
# Turns an unknown email into an irreversible id for the logs; also its own key
AUDIT_LOG_HMAC_KEY=
# Set into the iss and aud claims, and checked when a token is verified
JWT_ISSUER=backend-course-api
JWT_AUDIENCE=backend-course-web
# Email step after a correct password at login
LOGIN_EMAIL_CONFIRMATION_ENABLED=false
# otp | magic_link (used only when confirmation is enabled)
LOGIN_EMAIL_CONFIRMATION_METHOD=otp
# Page the login magic link opens; the token is appended after # (required for magic_link)
LOGIN_CONFIRM_URL=http://localhost:3000/login/confirm
# Comma-separated exact origins of frontends on another origin (CORS + CSRF).
# Leave empty when the frontend and the API share one origin.
TRUSTED_ORIGINS=http://localhost:5174,http://localhost:4200,http://localhost:8080
# SameSite of the auth cookies: strict (default), or none only when a trusted
# frontend is on another site (e.g. app.other.com calling api.example.com).
AUTH_COOKIE_SAME_SITE=strict

# RBAC
# UUID of an existing user who gets the admin role in the one-time bootstrap.
# A fresh DB has no users: register one, put its id here and restart.
# Until it is set and the user exists, the bootstrap is skipped.
# RBAC_BOOTSTRAP_ADMIN_USER_ID=

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true

# SMTP (local: Mailpit from docker-compose, UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
# true only for implicit TLS (usually port 465)
SMTP_SECURE=false
# Set both or neither; Mailpit needs no auth
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
