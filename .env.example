# Server options
PORT=3007
NODE_ENV=development
COOKIE_SECRET=my-secret

# Health check
HEALTH_CHECK_ENABLED=false

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10
# Per IP, separately for register and resend: LIMIT requests per TTL ms
THROTTLE_REGISTRATION_TTL=60000
THROTTLE_REGISTRATION_LIMIT=5

# Registration
REGISTRATION_EMAIL_CONFIRMATION_ENABLED=false
# otp | magic_link (used only when confirmation is enabled)
REGISTRATION_EMAIL_CONFIRMATION_METHOD=otp
# HMAC-SHA256 key for registration codes and link tokens, at least 32 bytes
REGISTRATION_CHALLENGE_HMAC_KEY=change-me-to-a-random-string-of-at-least-32-bytes
# Page the magic link opens; the token is appended after # (required for magic_link)
REGISTRATION_CONFIRM_URL=http://localhost:3000/register/confirm

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true

# SMTP (local: Mailpit from docker-compose, UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
# true only for implicit TLS (usually port 465)
SMTP_SECURE=false
# Set both or neither; Mailpit needs no auth
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com